<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.demo01.mapper.BoardCommentMapper">

    <resultMap id="CommentResultMap" type="com.demo01.model.Comment">
        <id property="id" column="id"/>
        <result property="author" column="author"/>
        <result property="text" column="comment_text"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="findByPostId" resultMap="CommentResultMap">
        SELECT id, author, comment_text, created_at 
        FROM board_comment 
        WHERE post_id = #{postId}
        ORDER BY created_at ASC
    </select>

    <insert id="insert">
        INSERT INTO board_comment (post_id, author, comment_text)
        VALUES (#{postId}, #{comment.author}, #{comment.text})
    </insert>

    <delete id="delete">
        DELETE FROM board_comment WHERE id = #{id}
    </delete>

</mapper>